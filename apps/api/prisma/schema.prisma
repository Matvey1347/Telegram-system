generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  owner
  admin
  MEDIA_BUYER
  member
}

enum TransactionType {
  income
  expense
}

enum CurrencyDisplayMode {
  code
  symbol
}

enum CampaignStatus {
  planned
  active
  finished
  cancelled
  archived
}

enum PromoStatus {
  draft
  active
  archived
}

enum TelegramUserAccountStatus {
  pending
  needs_code
  needs_password
  connected
  error
  disabled
}

enum TelegramSourceType {
  BOT
  MTPROTO
}

enum TelegramChannelSourceRole {
  OWNER
  ADMIN
  MEMBER
  UNKNOWN
}

enum TelegramChannelDataType {
  CHANNEL_INFO
  POSTS
  INVITE_LINKS
  STATS
  MEMBERS
  REACTIONS
  VIEWS
  OTHER
}

enum TelegramChannelAccessMode {
  PUBLIC
  PRIVATE
  PRIVATE_INVITE
  PRIVATE_JOIN_REQUEST
  UNKNOWN
}

enum TelegramChannelAcquisitionType {
  CREATED
  PURCHASED
}

enum TelegramDataSourceStatus {
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum TelegramInviteLinkCreatorMatchSource {
  TELEGRAM_USER_ID
  MTPROTO_USERNAME
  MEMBER_USERNAME
  UNRESOLVED
}

enum AdvertisingSourceType {
  telegram_channel
  instagram
  facebook
  website
  direct
  other
}

enum IconType {
  emoji
  image
}

enum TelegramChannelAdAnalysisStatus {
  NEW
  APPROVED
  REJECTED
  WATCH_LATER
  BLACKLIST
  TESTED
}

enum TelegramManagedPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum TelegramManagedPostRemoteStatus {
  NONE
  SCHEDULED
  PUBLISHED
  BROKEN
  MISSING
  UNKNOWN
}

enum TelegramManagedPostOrigin {
  SYSTEM
  TELEGRAM
}

enum TelegramAdPricingMode {
  CPM
  FIXED
  MANUAL
}

enum TelegramAdSlotStrategy {
  BEFORE_ORGANIC_POST
  FIXED_TIMES
  MANUAL
}

enum TelegramAdSaleStatus {
  DRAFT
  RESERVED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TelegramAdPlacementStatus {
  DRAFT
  RESERVED
  SCHEDULED
  PUBLISHED
  COMPLETED
  CANCELLED
  MISSED
}

enum TelegramAdSalePaymentStatus {
  ACTIVE
  VOIDED
}

enum TelegramAdvertiserStatus {
  LEAD
  ACTIVE
  INACTIVE
  LOST
  BLOCKED
  ARCHIVED
}

enum TelegramAdvertiserLifecycleStage {
  NEW
  CONTACTED
  QUALIFIED
  CUSTOMER
  REPEAT_CUSTOMER
  REACTIVATION
  CHURNED
}

enum TelegramAdvertiserContactType {
  TELEGRAM_USERNAME
  TELEGRAM_USER_ID
  PHONE
  EMAIL
  WEBSITE
  OTHER
}

enum TelegramAdCrmDealStage {
  NEW_LEAD
  CONTACTED
  NEED_IDENTIFIED
  OFFER_PREPARED
  OFFER_SENT
  NEGOTIATION
  SLOT_RESERVED
  WAITING_PAYMENT
  PAID
  SCHEDULED
  PUBLISHED
  COMPLETED
  LOST
}

enum TelegramAdvertiserActivityType {
  ADVERTISER_CREATED
  CONTACT_ADDED
  NOTE_ADDED
  MANUAL_CONTACT
  OUTREACH_PLANNED
  OUTREACH_COMPLETED
  CLIENT_REPLIED
  OFFER_SENT
  SALE_CREATED
  SALE_STAGE_CHANGED
  SLOT_RESERVED
  PAYMENT_RECORDED
  PLACEMENT_SCHEDULED
  PLACEMENT_PUBLISHED
  PLACEMENT_COMPLETED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_SKIPPED
  CLIENT_DECLINED
  CLIENT_REQUESTED_LATER_CONTACT
  CLIENT_REACTIVATED
  ADVERTISER_MERGED
  OWNER_CHANGED
  STATUS_CHANGED
}

enum TelegramAdvertiserTaskType {
  FOLLOW_UP
  PAYMENT_FOLLOW_UP
  REQUEST_FEEDBACK
  OFFER_FREE_SLOT
  REACTIVATION
  PREPARE_OFFER
  MANUAL
}

enum TelegramAdvertiserTaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

enum TelegramAdvertiserTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TelegramAdCrmOwnerMode {
  SALE_ASSIGNEE
  ADVERTISER_OWNER
  WORKSPACE_DEFAULT
}

enum TelegramAdvertiserAutomationEventType {
  PLACEMENT_COMPLETED
  PLACEMENT_PUBLISHED
  SALE_COMPLETED
  PAYMENT_OVERDUE
  ADVERTISER_INACTIVE
  FREE_SLOT_AVAILABLE
  HIGH_PERFORMING_PLACEMENT
  CLIENT_REQUESTED_LATER_CONTACT
}

enum TelegramAdvertiserAutomationActionType {
  CREATE_FOLLOW_UP_TASK
  CREATE_PAYMENT_TASK
  CREATE_FEEDBACK_TASK
  CREATE_REACTIVATION_TASK
  CREATE_FREE_SLOT_SUGGESTION
}

enum TelegramAdvertiserAutomationExecutionStatus {
  CREATED
  SKIPPED
  FAILED
}

enum TelegramAdPlacementAdvertiserResultSource {
  MANUAL
  ADVERTISER_REPORTED
  TRACKED
}

enum ApplicationLogLevel {
  debug
  info
  warn
  error
}

enum ApplicationLogKind {
  http
  application
  integration
  cron
  client
  audit
}

model User {
  id                             String                           @id @default(cuid())
  email                          String                           @unique
  seedKey                        String?                          @unique
  passwordHash                   String
  name                           String
  memberships                    WorkspaceMember[]
  icons                          Icon[]
  createdAccounts                Account[]                        @relation("AccountCreatedBy")
  createdTransactions            Transaction[]                    @relation("TransactionCreatedBy")
  createdTransfers               Transfer[]                       @relation("TransferCreatedBy")
  createdInvestments             Investment[]                     @relation("InvestmentCreatedBy")
  createdTelegramChannels        TelegramChannel[]                @relation("TelegramChannelCreatedBy")
  createdTelegramBots            TelegramBotIntegration[]         @relation("TelegramBotCreatedBy")
  createdTelegramUserAccounts    TelegramUserAccountIntegration[] @relation("TelegramUserAccountCreatedBy")
  createdPromos                  Promo[]                          @relation("PromoCreatedBy")
  createdAdvertisingSources      AdvertisingSource[]              @relation("AdvertisingSourceCreatedBy")
  createdAdCampaigns             AdCampaign[]                     @relation("AdCampaignCreatedBy")
  createdAdHypotheses            AdHypothesis[]                   @relation("AdHypothesisCreatedBy")
  createdTelegramChannelNetworks TelegramChannelNetwork[]         @relation("TelegramChannelNetworkCreatedBy")
  createdTelegramAdSales         TelegramAdSale[]                 @relation("TelegramAdSaleCreatedBy")
  createdTelegramAdSalePayments  TelegramAdSalePayment[]          @relation("TelegramAdSalePaymentCreatedBy")
  createdTelegramAdvertisers     TelegramAdvertiser[]             @relation("TelegramAdvertiserCreatedBy")
  assignedTelegramAdvertiserTags TelegramAdvertiserTagAssignment[]
  telegramAdvertiserActivities   TelegramAdvertiserActivity[]     @relation("TelegramAdvertiserActivityActorUser")
  createdTelegramAdvertiserTasks TelegramAdvertiserTask[]         @relation("TelegramAdvertiserTaskCreatedBy")
  createdTelegramPlacementAdvertiserResults TelegramAdPlacementAdvertiserResult[] @relation("TelegramAdPlacementAdvertiserResultCreatedBy")
  applicationLogs                ApplicationLog[]
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
}

model Workspace {
  id                  String              @id @default(cuid())
  name                String
  timezone            String              @default("Europe/Warsaw")
  primaryCurrency     String              @default("USD") @db.VarChar(3)
  secondaryCurrency   String              @default("UAH") @db.VarChar(3)
  currencyDisplayMode CurrencyDisplayMode @default(code)
  avatarIconId        String?

  members                           WorkspaceMember[]
  accounts                          Account[]
  transactions                      Transaction[]
  transfers                         Transfer[]
  telegramChannels                  TelegramChannel[]
  telegramBotIntegrations           TelegramBotIntegration[]
  telegramUserAccountIntegrations   TelegramUserAccountIntegration[]
  telegramChannelAdminLinks         TelegramChannelAdminLink[]
  telegramChannelSourceAccesses     TelegramChannelSourceAccess[]
  telegramChannelDataSources        TelegramChannelDataSource[]
  telegramChannelStatsSnapshots     TelegramChannelStatsSnapshot[]
  telegramChannelAudienceSnapshots  TelegramChannelAudienceSnapshot[]
  telegramChannelNetworks           TelegramChannelNetwork[]
  telegramChannelNetworkMembers     TelegramChannelNetworkMember[]
  telegramChannelStatsPoints        TelegramChannelStatsPoint[]
  telegramChannelAdAnalyses         TelegramChannelAdAnalysis[]
  telegramInviteLinkSnapshots       TelegramInviteLinkSnapshot[]
  telegramPosts                     TelegramPost[]
  telegramManagedPosts              TelegramManagedPost[]
  telegramManagedPostRevisions      TelegramManagedPostRevision[]
  telegramAdProducts                TelegramAdProduct[]
  telegramAdSchedulePolicies        TelegramAdSchedulePolicy[]
  telegramAdSalesWorkspaceSettings  TelegramAdSalesWorkspaceSettings?
  telegramAdSalesMemberPreferences  TelegramAdSalesMemberPreferences[]
  telegramAdPriceSnapshots          TelegramAdPriceSnapshot[]
  telegramAdInventoryDailySnapshots TelegramAdInventoryDailySnapshot[]
  telegramAdSales                   TelegramAdSale[]
  telegramAdSalePlacements          TelegramAdSalePlacement[]
  telegramAdSalePayments            TelegramAdSalePayment[]
  telegramAdSalePaymentAllocations  TelegramAdSalePaymentAllocation[]
  telegramAdvertisers               TelegramAdvertiser[]
  telegramAdvertiserContacts        TelegramAdvertiserContact[]
  telegramAdvertiserTags            TelegramAdvertiserTag[]
  telegramAdvertiserTagAssignments  TelegramAdvertiserTagAssignment[]
  telegramAdvertiserActivities      TelegramAdvertiserActivity[]
  telegramAdvertiserTasks           TelegramAdvertiserTask[]
  telegramAdCrmMemberSettings       TelegramAdCrmMemberSettings[]
  telegramAdCrmWorkspaceSettings    TelegramAdCrmWorkspaceSettings?
  telegramAdvertiserAutomationRules TelegramAdvertiserAutomationRule[]
  telegramAdvertiserAutomationExecutions TelegramAdvertiserAutomationExecution[]
  telegramAdPlacementAdvertiserResults   TelegramAdPlacementAdvertiserResult[]
  postGroups                        PostGroup[]
  promos                            Promo[]
  advertisingSources                AdvertisingSource[]
  adCampaigns                       AdCampaign[]
  adHypotheses                      AdHypothesis[]
  adHypothesisCampaigns             AdHypothesisCampaign[]
  dailyAnalyticsSyncRuns            DailyAnalyticsSyncRun[]
  exchangeRates                     ExchangeRate[]
  investments                       Investment[]
  transactionCategories             TransactionCategory[]
  icons                             Icon[]
  promptNotes                       PromptNote[]
  applicationLogs                   ApplicationLog[]
  avatarIcon                        Icon?                              @relation("WorkspaceAvatarIcon", fields: [avatarIconId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptNote {
  id                 String   @id @default(cuid())
  workspaceId        String
  title              String
  content            String
  emoji              String?
  iconId             String?
  assignedMemberId   String?
  telegramChannelId  String?
  telegramChannelIds String[] @default([])
  postGroupId        String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icon            Icon?            @relation(fields: [iconId], references: [id], onDelete: SetNull)
  assignedMember  WorkspaceMember? @relation("PromptNoteAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  telegramChannel TelegramChannel? @relation(fields: [telegramChannelId], references: [id], onDelete: SetNull)
  postGroup       PostGroup?       @relation(fields: [postGroupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, telegramChannelId])
  @@index([workspaceId, postGroupId])
  @@index([workspaceId, assignedMemberId])
  @@index([workspaceId, iconId])
}

model TelegramUserAccountIntegration {
  id                        String                    @id @default(cuid())
  workspaceId               String
  assignedMemberId          String?
  createdByUserId           String?
  label                     String
  apiId                     String
  apiHashEncrypted          String
  apiHashIv                 String
  apiHashAuthTag            String
  phoneMasked               String?
  phoneEncrypted            String?
  phoneIv                   String?
  phoneAuthTag              String?
  telegramUserId            String?
  username                  String?
  firstName                 String?
  lastName                  String?
  photoUrl                  String?
  nameColor                 Int?
  isPremium                 Boolean                   @default(false)
  premiumCheckedAt          DateTime?
  captionLengthMax          Int                       @default(1024)
  messageLengthMax          Int                       @default(4096)
  premiumCapabilities       Json?
  status                    TelegramUserAccountStatus @default(pending)
  lastErrorMessage          String?
  lastCheckedAt             DateTime?
  lastSyncedAt              DateTime?
  isActive                  Boolean                   @default(true)
  sessionEncrypted          String?
  sessionIv                 String?
  sessionAuthTag            String?
  loginPhoneCodeHash        String?
  loginTempSessionEncrypted String?
  loginTempSessionIv        String?
  loginTempSessionAuthTag   String?
  loginStartedAt            DateTime?

  workspace         Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedMember    WorkspaceMember?           @relation("TelegramUserAccountAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByUser     User?                      @relation("TelegramUserAccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  channelAdminLinks TelegramChannelAdminLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, assignedMemberId])
}

model TelegramChannelAdminLink {
  id                               String @id @default(cuid())
  workspaceId                      String
  telegramChannelId                String
  telegramUserAccountIntegrationId String
  source                           String @default("mtproto")

  workspace                      Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel                TelegramChannel                @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  telegramUserAccountIntegration TelegramUserAccountIntegration @relation(fields: [telegramUserAccountIntegrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, telegramChannelId, telegramUserAccountIntegrationId])
  @@index([workspaceId, telegramChannelId])
  @@index([workspaceId, telegramUserAccountIntegrationId])
}

model TelegramChannelSourceAccess {
  id                   String                    @id @default(cuid())
  workspaceId          String
  channelId            String
  sourceId             String
  sourceType           TelegramSourceType
  role                 TelegramChannelSourceRole @default(UNKNOWN)
  canPostMessages      Boolean                   @default(false)
  canEditMessages      Boolean                   @default(false)
  canDeleteMessages    Boolean                   @default(false)
  canInviteUsers       Boolean                   @default(false)
  canManageInviteLinks Boolean                   @default(false)
  canViewStats         Boolean                   @default(false)
  rawPermissions       Json?
  lastCheckedAt        DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   TelegramChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, sourceId, sourceType])
  @@index([workspaceId, channelId])
  @@index([workspaceId, sourceId, sourceType])
}

model TelegramChannelDataSource {
  id                String                   @id @default(cuid())
  workspaceId       String
  channelId         String
  sourceId          String
  sourceType        TelegramSourceType
  dataType          TelegramChannelDataType
  status            TelegramDataSourceStatus @default(SUCCESS)
  sourceDisplayName String?
  errorMessage      String?
  metadata          Json?
  syncedAt          DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   TelegramChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([workspaceId, channelId])
  @@index([workspaceId, sourceId, sourceType])
  @@index([workspaceId, channelId, dataType])
}

model WorkspaceMember {
  id               String        @id @default(cuid())
  workspaceId      String
  userId           String
  role             WorkspaceRole @default(admin)
  isHidden         Boolean       @default(false)
  avatarIconId     String?
  telegramUsername String?

  workspace                            Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                                 User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarIcon                           Icon?                            @relation(fields: [avatarIconId], references: [id], onDelete: SetNull)
  investments                          Investment[]
  investmentTransactions               Transaction[]                    @relation("MemberInvestmentTransactions")
  assignedAccounts                     Account[]                        @relation("AccountAssignedMember")
  assignedTransactions                 Transaction[]                    @relation("TransactionAssignedMember")
  assignedTransfers                    Transfer[]                       @relation("TransferAssignedMember")
  assignedInvestments                  Investment[]                     @relation("InvestmentAssignedMember")
  assignedTelegramChannels             TelegramChannel[]                @relation("TelegramChannelAssignedMember")
  assignedTelegramBots                 TelegramBotIntegration[]         @relation("TelegramBotAssignedMember")
  assignedTelegramUserAccounts         TelegramUserAccountIntegration[] @relation("TelegramUserAccountAssignedMember")
  assignedPromos                       Promo[]                          @relation("PromoAssignedMember")
  assignedAdvertisingSources           AdvertisingSource[]              @relation("AdvertisingSourceAssignedMember")
  assignedAdCampaigns                  AdCampaign[]                     @relation("AdCampaignAssignedMember")
  assignedAdHypotheses                 AdHypothesis[]                   @relation("AdHypothesisAssignedMember")
  assignedTelegramChannelNetworks      TelegramChannelNetwork[]         @relation("TelegramChannelNetworkAssignedMember")
  assignedTelegramChannelAdAnalyses    TelegramChannelAdAnalysis[]      @relation("TelegramChannelAdAnalysisAssignedMember")
  assignedTelegramManagedPosts         TelegramManagedPost[]            @relation("TelegramManagedPostAssignedMember")
  assignedTelegramManagedPostRevisions TelegramManagedPostRevision[]    @relation("TelegramManagedPostRevisionAssignedMember")
  assignedTelegramAdSales              TelegramAdSale[]                 @relation("TelegramAdSaleAssignedMember")
  ownedTelegramAdvertisers             TelegramAdvertiser[]             @relation("TelegramAdvertiserOwner")
  telegramAdvertiserActivities         TelegramAdvertiserActivity[]     @relation("TelegramAdvertiserActivityActorMember")
  assignedTelegramAdvertiserTasks      TelegramAdvertiserTask[]         @relation("TelegramAdvertiserTaskAssignedMember")
  telegramAdCrmSettings                TelegramAdCrmMemberSettings?
  telegramAdSalesPreferences           TelegramAdSalesMemberPreferences?
  specificTelegramAdvertiserAutomationRules TelegramAdvertiserAutomationRule[] @relation("TelegramAdvertiserAutomationSpecificMember")
  createdPostGroups                    PostGroup[]                      @relation("PostGroupCreatedByMember")
  createdTelegramInviteLinks           TelegramInviteLink[]             @relation("TelegramInviteLinkCreatorMember")
  promptNotes                          PromptNote[]                     @relation("PromptNoteAssignedMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@unique([workspaceId, telegramUsername])
  @@unique([id, workspaceId])
}

model Account {
  id               String  @id @default(cuid())
  workspaceId      String
  name             String
  currency         String  @db.VarChar(3)
  initialBalance   Decimal @default(0)
  isActive         Boolean @default(true)
  iconId           String?
  assignedMemberId String?
  createdByUserId  String?

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  icon           Icon?            @relation(fields: [iconId], references: [id], onDelete: SetNull)
  assignedMember WorkspaceMember? @relation("AccountAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByUser  User?            @relation("AccountCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  transactions           Transaction[]
  outgoingTransfers      Transfer[]              @relation("OutgoingTransfers")
  incomingTransfers      Transfer[]              @relation("IncomingTransfers")
  adCampaigns            AdCampaign[]
  investments            Investment[]
  telegramAdSalePayments TelegramAdSalePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, assignedMemberId])
}

model Transaction {
  id                      String          @id @default(cuid())
  workspaceId             String
  accountId               String
  telegramChannelId       String?
  type                    TransactionType
  amount                  Decimal
  currency                String          @db.VarChar(3)
  amountInPrimaryCurrency Decimal
  exchangeRateToPrimary   Decimal
  category                String
  categoryId              String?
  memberId                String?
  description             String?
  date                    DateTime
  adCampaignId            String?         @unique
  createdByUserId         String?
  iconId                  String?
  assignedMemberId        String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  telegramChannel TelegramChannel? @relation("TelegramChannelRevenueTransactions", fields: [telegramChannelId], references: [id], onDelete: SetNull)

  adCampaign                    AdCampaign?            @relation("CampaignExpenseTransaction", fields: [adCampaignId], references: [id])
  investment                    Investment?
  telegramAdSalePayment         TelegramAdSalePayment?
  telegramAdSalePaymentReversal TelegramAdSalePayment? @relation("TelegramAdSalePaymentReversalTransaction")
  purchasedTelegramChannel      TelegramChannel?       @relation("TelegramChannelPurchaseTransaction")
  categoryRef                   TransactionCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  member                        WorkspaceMember?       @relation("MemberInvestmentTransactions", fields: [memberId], references: [id], onDelete: SetNull)
  icon                          Icon?                  @relation(fields: [iconId], references: [id], onDelete: SetNull)
  assignedMember                WorkspaceMember?       @relation("TransactionAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByUser                 User?                  @relation("TransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, type, categoryId])
  @@index([workspaceId, memberId])
  @@index([workspaceId, assignedMemberId])
  @@index([workspaceId, telegramChannelId])
}

model TransactionCategory {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  type        TransactionType
  isSystem    Boolean         @default(false)
  key         String?
  iconId      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions Transaction[] @relation
  icon         Icon?         @relation(fields: [iconId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, type, key])
  @@index([workspaceId, type])
}

model Investment {
  id                      String   @id @default(cuid())
  workspaceId             String
  workspaceMemberId       String
  accountId               String
  transactionId           String?  @unique
  amount                  Decimal
  currency                String   @db.VarChar(3)
  amountInPrimaryCurrency Decimal
  exchangeRateToPrimary   Decimal
  date                    DateTime
  notes                   String?
  createdByUserId         String?
  assignedMemberId        String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember  @relation(fields: [workspaceMemberId], references: [id], onDelete: Restrict)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction     Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  assignedMember  WorkspaceMember? @relation("InvestmentAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByUser   User?            @relation("InvestmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, assignedMemberId])
}

model Transfer {
  id                   String   @id @default(cuid())
  workspaceId          String
  fromAccountId        String
  toAccountId          String
  fromAmount           Decimal
  fromCurrency         String   @db.VarChar(3)
  toAmount             Decimal
  toCurrency           String   @db.VarChar(3)
  exchangeRate         Decimal?
  expectedToAmount     Decimal?
  transferLossAmount   Decimal?
  transferLossCurrency String?  @db.VarChar(3)
  date                 DateTime
  description          String?
  createdByUserId      String?
  assignedMemberId     String?

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromAccount    Account          @relation("OutgoingTransfers", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount      Account          @relation("IncomingTransfers", fields: [toAccountId], references: [id], onDelete: Restrict)
  assignedMember WorkspaceMember? @relation("TransferAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByUser  User?            @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId, assignedMemberId])
}

model TelegramChannel {
  id                        String                         @id @default(cuid())
  workspaceId               String
  title                     String
  username                  String?
  telegramChatId            String?
  telegramAccessHash        String?
  accessMode                TelegramChannelAccessMode      @default(UNKNOWN)
  requiresJoinRequest       Boolean                        @default(false)
  lastEntityResolvedAt      DateTime?
  inviteLink                String?
  description               String?
  language                  String?
  niche                     String?
  currentSubscribersCount   Int?
  seedSubscribersCount      Int                            @default(0)
  activeSubscribersWindow   Int                            @default(5)
  knownFakeSubscribersCount Int                            @default(0)
  ownViewsPerPost           Int                            @default(0)
