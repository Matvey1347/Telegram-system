  @@unique([workspaceId, telegramChannelId, remoteImportKey])
  @@index([workspaceId, telegramChannelId, createdAt])
  @@index([workspaceId, assignedMemberId])
  @@index([groupId])
  @@index([groupId, groupPosition])
  @@index([telegramChannelId, sidebarPosition])
  @@index([status, scheduledAt])
  @@index([workspaceId, telegramChannelId, origin, status, scheduledAt])
}

model TelegramManagedPostRevision {
  id                    String                          @id @default(cuid())
  telegramManagedPostId String
  workspaceId           String
  telegramChannelId     String
  title                 String
  text                  String?
  imageUrls             String[]                        @default([])
  origin                TelegramManagedPostOrigin       @default(SYSTEM)
  remoteImportKey       String?
  status                TelegramManagedPostStatus
  scheduledAt           DateTime?
  publishedAt           DateTime?
  telegramMessageIds    String[]                        @default([])
  telegramMessageUrls   String[]                        @default([])
  telegramRemoteStatus  TelegramManagedPostRemoteStatus @default(NONE)
  lastTelegramSyncedAt  DateTime?
  lastTelegramSyncNote  String?
  sourceType            TelegramSourceType?
  sourceId              String?
  sourceWasPremium      Boolean?
  captionLengthMaxUsed  Int?
  messageLengthMaxUsed  Int?
  publishMode           String?
  lastError             String?
  assignedMemberId      String
  icon                  String?
  groupId               String?
  groupPosition         Int?
  sidebarPosition       Int?
  reason                String

  telegramManagedPost TelegramManagedPost @relation(fields: [telegramManagedPostId], references: [id], onDelete: Cascade)
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel     TelegramChannel     @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  assignedMember      WorkspaceMember     @relation("TelegramManagedPostRevisionAssignedMember", fields: [assignedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  group               PostGroup?          @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([telegramManagedPostId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([telegramChannelId, createdAt])
}

model PostGroup {
  id                String  @id @default(cuid())
  workspaceId       String
  telegramChannelId String
  title             String
  description       String?
  icon              String?
  isSystem          Boolean @default(false)
  systemKey         String?
  createdByMemberId String
  sidebarPosition   Int?

  workspace            Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  telegramChannel      TelegramChannel               @relation(fields: [telegramChannelId], references: [id], onDelete: Cascade)
  createdByMember      WorkspaceMember               @relation("PostGroupCreatedByMember", fields: [createdByMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  posts                TelegramManagedPost[]
  managedPostRevisions TelegramManagedPostRevision[]
  promptNotes          PromptNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([telegramChannelId, systemKey])
  @@index([workspaceId])
  @@index([telegramChannelId])
  @@index([createdByMemberId])
  @@index([telegramChannelId, sidebarPosition])
}

model TelegramPostMetricSnapshot {
  id             String   @id @default(cuid())
  telegramPostId String
  viewsCount     Int?
  forwardsCount  Int?
  reactionsCount Int?
  commentsCount  Int?
  reactions      Json?
  collectedAt    DateTime @default(now())

  telegramPost TelegramPost @relation(fields: [telegramPostId], references: [id], onDelete: Cascade)

  @@index([telegramPostId, collectedAt])
}

model ExchangeRate {
  id             String   @id @default(cuid())
  workspaceId    String
  baseCurrency   String   @db.VarChar(3)
  targetCurrency String   @db.VarChar(3)
  rate           Decimal
  date           DateTime
  source         String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, baseCurrency, targetCurrency, date])
}

model Icon {
  id              String   @id @default(cuid())
  workspaceId     String?
  type            IconType
  name            String
  emoji           String?
  imageUrl        String?
  createdByUserId String?

  workspace                Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdByUser            User?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  workspaceAvatars         Workspace[]               @relation("WorkspaceAvatarIcon")
  workspaceMembers         WorkspaceMember[]
  accounts                 Account[]
  transactions             Transaction[]
  transactionCategories    TransactionCategory[]
  promptNotes              PromptNote[]
  promos                   Promo[]
  adHypotheses             AdHypothesis[]
  telegramChannelTimePosts TelegramChannelTimePost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, type, name])
  @@index([workspaceId, name, type])
  @@index([workspaceId, type])
  @@index([createdByUserId])
}
